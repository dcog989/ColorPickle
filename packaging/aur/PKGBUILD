# Maintainer: dcog989 <sirdavidlaws@gmail.com>
pkgname=colorpickle
_reponame=ColorPickle
pkgver=0.2.2
pkgrel=1
pkgdesc="Linux screen color picker: pick a pixel or drag-select a region, get the color in any common format, copy it."
arch=('x86_64' 'aarch64')
url="https://github.com/dcog989/ColorPickle"
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxkbcommon' 'libxkbcommon-x11' 'libxrandr' 'libglvnd' 'mesa' 'wayland')
optdepends=('xdg-desktop-portal: screenshot fallback')
makedepends=('pkgconf' 'rust')
source=("$pkgname-$pkgver.tar.gz::https://github.com/dcog989/ColorPickle/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$_reponame-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_reponame-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

package() {
    cd "$_reponame-$pkgver"
    install -Dm755 target/release/colorpickle "$pkgdir/usr/bin/colorpickle"
    install -Dm644 packaging/colorpickle.desktop "$pkgdir/usr/share/applications/colorpickle.desktop"
    install -Dm644 packaging/colorpickle.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/colorpickle.svg"
    install -Dm644 assets/colorpickle.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/colorpickle.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
