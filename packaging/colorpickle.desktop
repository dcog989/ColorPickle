[Desktop Entry]
Type=Application
Name=ColorPickle
Comment=Pick a color from anywhere on screen
Exec=colorpickle
Icon=colorpickle
Terminal=false
Categories=Graphics;Utility;
Keywords=color;colour;picker;eyedropper;
Actions=Pick;
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2

[Desktop Action Pick]
Name=Pick a color
Exec=colorpickle --launch-mode picker_first
